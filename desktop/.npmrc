# Refuse to install on a Node outside package.json's `engines` range, instead of
# warning. Electron's postinstall extracts its binary with extract-zip, which on
# Node 26 writes one file, hangs, and lets the process exit 0 -- so `npm ci`
# reports success and `electron .` then dies with "Electron failed to install
# correctly". A failed install is the honest outcome; see docs/adr/0014.
engine-strict=true

# Copy to .env to set any of these locally. .env is gitignored and never committed.
#
# There are no API keys here, and there is no cloud service to sign up for.
# Every model runs locally on onnxruntime; media never leaves the machine.
# (An earlier build used a hosted embedding API. That key is retired —
# config/settings.py deletes it from secrets.json on load.)
#
# Explicit environment variables always win over this file: config/settings.py's
# _load_dotenv uses setdefault, so a value already in the environment is kept.
#
# All three below are optional. Packaged builds and CI set them; a source
# checkout normally needs none of them.

# Directory holding bundled native tools (ffmpeg, ffprobe, exiftool). Searched
# before PATH. Set by the desktop launcher; unset in a source checkout, where
# the system PATH copies are used instead.
ARCHIVE_TOOLS_DIR=

# Directory holding models bundled with a packaged build (see
# packaging/models/manifest.json). Searched before the download cache, so an
# installed app works offline on first run.
ARCHIVE_MODELS_DIR=

# Build commit, reported by /api/health and the desktop About box. Stamped by
# the release workflows; falls back to "dev".
ARCHIVE_BUILD_COMMIT=

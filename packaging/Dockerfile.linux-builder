# Reproducible Linux x64 backend-build environment. PyInstaller requires objdump
# (provided by binutils) to analyse bundled native libraries. OpenCV is optional
# at runtime, but the build must be able to import it to collect native libraries.
FROM python:3.13-slim

RUN apt-get update \
    && apt-get install --no-install-recommends -y binutils libgl1 libglib2.0-0 libice6 libsm6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Indentation and line endings, applied by the editor before any tool runs.
# Understood natively by most editors and via a plugin by the rest.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.{js,cjs,mjs,json,yml,yaml,html,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false    # two trailing spaces is a markdown line break

[Makefile]
indent_style = tab

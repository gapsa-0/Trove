# Data: database, cache, thumbnails — never commit the catalog or media
/data/
# Throwaway XDG_DATA_HOME for `make gui`, so a dev run never opens the real archive.
/.devdata/
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.eggs/
# Anchored: these are the setuptools output directories at the repo root. Written
# bare they also match tools/build/, so a new script added there was silently
# invisible to `git add` -- and to ruff, which honours .gitignore.
/build/
/dist/

# Env / editors
.env
.vscode/
.idea/
.DS_Store
desktop/node_modules/
desktop/release/
desktop/backend/
desktop/dist/
packaging/tools/staged/
packaging/models/staged/

# Plan folder

plan/
fast_tasks.md

# Local working notes for AI assistants: they describe this specific machine's
# archive (paths, family folder names) and are not useful to anyone else.
CLAUDE.md
.claude/
AGENTS.md
